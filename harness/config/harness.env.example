# job-search harness secrets and settings.
# Copy to harness.env and fill in. NEVER commit harness.env.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (only this id can control the bot).
# Get it from @userinfobot.
TELEGRAM_OWNER_ID=

# Path to the ai-job-search repo on the Pi
AIJOB_DIR=/home/pi/ai-job-search

# How many offers to put in the daily shortlist
SHORTLIST_SIZE=10

# opencode agent used for unattended command runs
OPENCODE_AGENT=harness

# Max seconds per opencode run
RUN_TIMEOUT=3600

# Max status:new jobs to rank per run (newest first). 0 = no cap.
RANK_MAX_NEW=200
